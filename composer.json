{
    "name": "eye4web/zf2-site-config",
    "description": "Site-configuration module for Zend Framework 2",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "zf2",
        "configuration"
    ],
    "homepage": "https://github.com/Eye4web/ZF2-Site-Config",
    "authors": [
        {
            "name": "Daniel Strøm",
            "email": "ds@eye4web.dk"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "master-dev"
        }
    },
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "laminas/laminas-config": "^3.5",
        "laminas/laminas-servicemanager": "^3.24",
        "ocramius/proxy-manager": "dev-renovate/all-minor-patch"
    },
    "autoload": {
        "psr-0": {
            "Eye4web\\SiteConfig": "src/"
        }
    },
    "require-dev": {
        "codeclimate/php-test-reporter": "dev-master",
        "container-interop/container-interop": "^1.1",
        "phpunit/phpunit": "4.*",
        "ramsey/uuid": "2.7.3",
        "squizlabs/php_codesniffer": "1.5.*",
        "laminas/laminas-code": "^2.5",
        "laminas/laminas-config": "^2.5"
      
    }
}